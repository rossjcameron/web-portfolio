# Public (build-time) — Cloudflare Turnstile site key for the contact form widget
PUBLIC_TURNSTILE_SITE_KEY=

# Server-side secrets — set these in Cloudflare Pages → Settings → Environment variables (encrypt them),
# or in a local .dev.vars file for `wrangler pages dev`. Never commit real values.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
