---
interface Props {
  eyebrow: string
  title: string
  lede?: string
}
const { eyebrow, title, lede } = Astro.props
---

<section class="page-header">
  <div class="shell">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="page-header__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--color-rule);
  }

  .page-header .shell {
    display: grid;
    gap: 1.5rem;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 1.1rem + 4.6vw, 5.25rem);
    font-weight: 600;
    font-stretch: 92%;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .page-header__lede {
    max-width: 46ch;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-slate);
  }
</style>
