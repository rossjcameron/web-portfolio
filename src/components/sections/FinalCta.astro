---
import Button from '../Button.astro'
import { site } from '../../data/site'
---

<section class="cta on-dark" aria-labelledby="cta-title" data-cta>
  <div class="shell cta__inner">
    <div class="cta__copy">
      <h2 id="cta-title">Ready for a new window?</h2>
      <p>Tell us a little about your business and what you need. We’ll help you find the right starting point.</p>
      <div class="cta__actions">
        <Button href="/contact/" variant="sea" size="lg" arrow>Let’s talk about your website</Button>
        <a href="/pricing/" class="link-arrow cta__link">View pricing</a>
      </div>
      {site.email && <p class="cta__email">Or email <a href={`mailto:${site.email}`}>{site.email}</a></p>}
    </div>

    <div class="sash" aria-hidden="true" data-sash>
      <div class="sash__light"></div>
      <div class="sash__pane sash__pane--left"><i></i></div>
      <div class="sash__pane sash__pane--right"><i></i></div>
      <div class="sash__frame"></div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(5rem, 11vw, 8.5rem);
    background: var(--color-midnight);
    color: var(--color-paper);
    border-bottom: 1px solid var(--color-rule-dark);
  }

  .cta__inner {
    display: grid;
    grid-template-columns: 7fr 5fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .cta__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .cta h2 {
    font-size: clamp(2.6rem, 1.2rem + 5vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-stretch: 92%;
  }

  .cta__copy > p {
    max-width: 40ch;
    font-size: var(--text-lead);
    color: var(--color-mist);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.5rem;
  }

  .cta__link {
    color: var(--color-paper);
  }

  .cta__email {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-mist);
  }

  .cta__email a {
    color: var(--color-paper);
  }

  @media (max-width: 899px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }
  }

  /* A window that slides open when it comes into view */
  .sash {
    position: relative;
    width: min(100%, 26rem);
    aspect-ratio: 4 / 5;
    justify-self: end;
    overflow: hidden;
  }

  @media (max-width: 899px) {
    .sash {
      justify-self: start;
      width: min(100%, 18rem);
    }
  }

  .sash__light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 60% at 70% 20%, rgb(255 255 255 / 0.55), transparent 60%),
      linear-gradient(180deg, var(--color-mint), var(--color-sea) 70%, #4f9fa2);
  }

  .sash__pane {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    border: 10px solid #22323c;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.02) 50%, rgb(255 255 255 / 0.06));
    backdrop-filter: blur(2px);
    transition: transform 1.4s var(--ease-out-soft);
  }

  .sash__pane i {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 8px;
    background: #22323c;
  }

  .sash__pane--left {
    left: 0;
  }

  .sash__pane--right {
    right: 0;
  }

  .sash__frame {
    position: absolute;
    inset: 0;
    border: 14px solid #2b3d48;
    pointer-events: none;
  }

  .sash.is-open .sash__pane--left {
    transform: translateX(-82%);
  }

  .sash.is-open .sash__pane--right {
    transform: translateX(82%);
  }

  @media (prefers-reduced-motion: reduce) {
    .sash__pane--left {
      transform: translateX(-82%);
    }

    .sash__pane--right {
      transform: translateX(82%);
    }
  }
</style>

<script>
  const sash = document.querySelector<HTMLElement>('[data-sash]')
  if (sash) {
    if (!('IntersectionObserver' in window)) {
      sash.classList.add('is-open')
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry?.isIntersecting) {
            sash.classList.add('is-open')
            observer.disconnect()
          }
        },
        { threshold: 0.5 },
      )
      observer.observe(sash)
    }
  }
</script>
