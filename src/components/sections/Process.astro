---
import SectionLabel from '../SectionLabel.astro'

interface Props {
  index?: string
}
const { index = '06' } = Astro.props

const steps = [
  { title: 'Tell us about your business', text: 'An initial enquiry to understand your services, your customers and what you need from a website.' },
  { title: 'We plan and design', text: 'We agree the scope, the structure of the site and the overall visual direction with you.' },
  { title: 'We build your website', text: 'We develop and refine the site, then test it across phones, tablets and desktops.' },
  { title: 'Your site goes live', text: 'We complete the final checks, connect your domain and publish your new website.' },
] as const
---

<section class="process" aria-labelledby="process-title" data-process>
  <div class="shell">
    <div class="process__head">
      <SectionLabel index={index}>How it works</SectionLabel>
      <h2 id="process-title" data-reveal>From first conversation to final launch.</h2>
    </div>

    <div class="process__track" aria-hidden="true"><span data-process-line></span></div>
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: clamp(4.5rem, 9vw, 7rem);
    border-top: 1px solid var(--color-rule);
  }

  .process__head {
    display: grid;
    gap: 1.75rem;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .process__head h2 {
    max-width: 18ch;
    font-size: var(--text-headline);
    line-height: var(--text-headline--line-height);
    letter-spacing: var(--text-headline--letter-spacing);
    font-stretch: 94%;
  }

  .process__track {
    height: 1px;
    background: var(--color-rule);
  }

  .process__track span {
    display: block;
    height: 2px;
    margin-top: -0.5px;
    background: var(--color-ink);
    transform-origin: left;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
  }

  .steps li {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1.75rem;
  }

  .steps__num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-slate);
  }

  .steps h3 {
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .steps p {
    color: var(--color-slate);
  }

  @media (max-width: 1023px) {
    .process__track {
      display: none;
    }

    .steps {
      grid-template-columns: 1fr;
      border-left: 1px solid var(--color-rule);
    }

    .steps li {
      position: relative;
      padding: 0 0 2.5rem 1.75rem;
    }

    .steps li::before {
      content: '';
      position: absolute;
      left: -5px;
      top: 0.35rem;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--color-ink);
    }

    .steps li:last-child {
      padding-bottom: 0;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const line = document.querySelector('[data-process-line]')
  if (line) {
    gsap.matchMedia().add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      gsap.fromTo(
        line,
        { scaleX: 0 },
        {
          scaleX: 1,
          ease: 'none',
          scrollTrigger: { trigger: '[data-process]', start: 'top 70%', end: 'bottom 75%', scrub: 0.5 },
        },
      )
    })
  }
</script>
