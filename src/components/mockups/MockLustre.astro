---
// Concept website for a fictional mobile car detailing business.
---

<div class="mk" aria-hidden="true">
  <header class="nav">
    <span class="logo">LUSTRE<small>auto care</small></span>
    <span class="links"><span>Packages</span><span>Results</span><span>Areas</span></span>
    <span class="btn">Book a detail</span>
    <span class="burger"><i></i><i></i></span>
  </header>

  <div class="hero">
    <div class="copy">
      <span class="kicker"><i></i>Mobile detailing · Leeds &amp; Harrogate</span>
      <p class="h">Showroom finish, <em>at your door.</em></p>
      <p class="p">Hand washes, paint correction and ceramic protection, carried out at your home or workplace.</p>
      <div class="ctas"><span class="btn">Check availability</span><span class="ghost">View packages</span></div>
    </div>

    <div class="art">
      <div class="paint"></div>
      <div class="beads"></div>
      <span class="chip">Ceramic protection<b>Hydrophobic finish</b></span>
    </div>
  </div>

  <div class="packages">
    <div><span>Maintenance valet</span><b>£45</b><small>Wash, dry, interior refresh</small></div>
    <div class="on"><span>Enhancement detail</span><b>£180</b><small>Single-stage polish, sealant</small></div>
    <div><span>Ceramic protection</span><b>from £450</b><small>Correction and coating</small></div>
  </div>
</div>

<style>
  .mk {
    --bg: #0e1012;
    --ink: #eceae6;
    --muted: #8f969b;
    --accent: #ff6a3d;
    --line: rgb(236 234 230 / 0.1);
    container-type: inline-size;
    min-height: 100%;
    padding: 2.6cqi 4cqi 4cqi;
    background:
      radial-gradient(60% 50% at 80% 10%, rgb(255 106 61 / 0.08), transparent 70%),
      var(--bg);
    color: var(--ink);
    font-family: var(--font-sans);
    line-height: 1.25;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 3.2cqi;
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 1cqi;
    margin-right: auto;
    font-size: 2.1cqi;
    font-weight: 700;
    font-stretch: 75%;
    letter-spacing: 0.18em;
  }

  .logo small {
    font-size: 1.15cqi;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .links {
    display: flex;
    gap: 2.8cqi;
    font-size: 1.4cqi;
    color: var(--muted);
  }

  .btn {
    padding: 1.15cqi 2.2cqi;
    border-radius: 0.6cqi;
    background: var(--accent);
    color: #140805;
    font-size: 1.35cqi;
    font-weight: 700;
    white-space: nowrap;
  }

  .burger {
    display: none;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4cqi;
    padding-top: 5cqi;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 1cqi;
    margin-bottom: 2.2cqi;
    font-family: var(--font-mono);
    font-size: 1.15cqi;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .kicker i {
    width: 0.9cqi;
    height: 0.9cqi;
    border-radius: 50%;
    background: var(--accent);
  }

  .h {
    margin: 0;
    font-size: 6cqi;
    font-weight: 700;
    font-stretch: 78%;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .h em {
    display: block;
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 0.12cqi var(--ink);
  }

  .p {
    max-width: 32ch;
    margin: 2.4cqi 0 3.2cqi;
    font-size: 1.55cqi;
    line-height: 1.5;
    color: var(--muted);
  }

  .ctas {
    display: flex;
    align-items: center;
    gap: 1.6cqi;
  }

  .ghost {
    padding: 1.15cqi 2.2cqi;
    border: 1px solid var(--line);
    border-radius: 0.6cqi;
    font-size: 1.35cqi;
    font-weight: 600;
  }

  .art {
    position: relative;
    aspect-ratio: 1.25;
    overflow: hidden;
    border-radius: 1.4cqi;
  }

  /* Reflections across dark paintwork */
  .paint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(162deg, transparent 38%, rgb(255 255 255 / 0.55) 41%, rgb(255 255 255 / 0.08) 45%, transparent 52%),
      linear-gradient(162deg, transparent 58%, rgb(255 255 255 / 0.14) 61%, transparent 66%),
      radial-gradient(70% 60% at 30% 20%, #3b4249, transparent 70%),
      linear-gradient(180deg, #23282d, #08090a);
  }

  /* Water beading */
  .beads {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.9) 0 0.18cqi, rgb(255 255 255 / 0.18) 0.22cqi 0.7cqi, transparent 0.8cqi) 0 0 / 5.2cqi 4.4cqi,
      radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.8) 0 0.12cqi, rgb(255 255 255 / 0.14) 0.16cqi 0.45cqi, transparent 0.55cqi) 2.4cqi 2cqi / 3.6cqi 3.2cqi;
    -webkit-mask-image: linear-gradient(200deg, #000 15%, transparent 60%);
    mask-image: linear-gradient(200deg, #000 15%, transparent 60%);
  }

  .chip {
    position: absolute;
    right: 2cqi;
    bottom: 2cqi;
    display: grid;
    gap: 0.3cqi;
    padding: 1.2cqi 1.8cqi;
    border: 1px solid var(--line);
    border-radius: 1cqi;
    background: rgb(14 16 18 / 0.72);
    backdrop-filter: blur(6px);
    font-size: 1.1cqi;
    color: var(--muted);
  }

  .chip b {
    color: var(--ink);
    font-size: 1.35cqi;
  }

  .packages {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6cqi;
    margin-top: 4cqi;
  }

  .packages div {
    display: grid;
    gap: 0.6cqi;
    padding: 2cqi;
    border: 1px solid var(--line);
    border-radius: 1cqi;
    font-size: 1.3cqi;
    color: var(--muted);
  }

  .packages .on {
    border-color: var(--accent);
  }

  .packages b {
    color: var(--ink);
    font-size: 2.4cqi;
    font-stretch: 80%;
  }

  .packages small {
    font-size: 1.15cqi;
  }

  @container (max-width: 520px) {
    .mk {
      padding: 13cqi 6cqi 6cqi;
    }

    .logo {
      font-size: 5cqi;
    }

    .logo small {
      font-size: 2.8cqi;
    }

    .links,
    .nav .btn {
      display: none;
    }

    .burger {
      display: grid;
      gap: 1.6cqi;
      width: 6cqi;
    }

    .burger i {
      height: 0.6cqi;
      background: var(--ink);
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 6cqi;
      padding-top: 7cqi;
    }

    .kicker {
      font-size: 2.8cqi;
      gap: 2cqi;
      margin-bottom: 3.5cqi;
    }

    .kicker i {
      width: 2cqi;
      height: 2cqi;
    }

    .h {
      font-size: 13.5cqi;
    }

    .p {
      font-size: 4.1cqi;
      margin: 4cqi 0 5cqi;
    }

    .ctas .btn,
    .ghost {
      font-size: 3.5cqi;
      padding: 3cqi 4cqi;
      border-radius: 1.6cqi;
    }

    .art {
      border-radius: 3cqi;
    }

    .beads {
      background-size: 11cqi 9cqi, 8cqi 7cqi;
    }

    .chip {
      font-size: 2.8cqi;
      padding: 2.4cqi 3.4cqi;
      border-radius: 2.4cqi;
      right: 3cqi;
      bottom: 3cqi;
    }

    .chip b {
      font-size: 3.4cqi;
    }

    .packages {
      grid-template-columns: 1fr;
      gap: 3cqi;
      margin-top: 7cqi;
    }

    .packages div {
      padding: 4cqi;
      font-size: 3.4cqi;
      border-radius: 2.4cqi;
    }

    .packages b {
      font-size: 6cqi;
    }

    .packages small {
      font-size: 3cqi;
    }
  }
</style>
