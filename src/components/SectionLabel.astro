---
interface Props {
  index?: string
  class?: string
}
const { index, class: className } = Astro.props
---

<p class:list={['eyebrow section-label', className]}>{index && <span class="section-label__index">{index}</span>}<slot /></p>

<style>
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-label__index {
    display: inline-grid;
    place-items: center;
    min-width: 2.1rem;
    height: 1.45rem;
    padding-inline: 0.4rem;
    border: 1px solid currentColor;
    border-radius: 3px;
    font-size: 0.7rem;
  }
</style>
