---
type Name = 'arrow-right' | 'arrow-up-right' | 'check' | 'plus' | 'minus' | 'menu' | 'close' | 'lock' | 'mail' | 'phone'
interface Props {
  name: Name
  class?: string
  size?: number
}
const { name, class: className, size = 18 } = Astro.props
const paths: Record<Name, string> = {
  'arrow-right': '<path d="M4 10h12M11 5l5 5-5 5"/>',
  'arrow-up-right': '<path d="M6 14 14 6M7 6h7v7"/>',
  check: '<path d="m4.5 10.5 3.5 3.5 7.5-8"/>',
  plus: '<path d="M10 4v12M4 10h12"/>',
  minus: '<path d="M4 10h12"/>',
  menu: '<path d="M3 6.5h14M3 13.5h14"/>',
  close: '<path d="m5 5 10 10M15 5 5 15"/>',
  lock: '<rect x="5" y="9" width="10" height="7.5" rx="1.5"/><path d="M7.5 9V6.8a2.5 2.5 0 0 1 5 0V9"/>',
  mail: '<rect x="3" y="4.5" width="14" height="11" rx="1.5"/><path d="m3.5 5.5 6.5 5 6.5-5"/>',
  phone: '<path d="M6.2 3.5h-2a1 1 0 0 0-1 1.1A13 13 0 0 0 15.4 16.8a1 1 0 0 0 1.1-1v-2a1 1 0 0 0-.8-1l-2.6-.6a1 1 0 0 0-.9.3l-1.1 1.1a10 10 0 0 1-4.6-4.6l1.1-1.1a1 1 0 0 0 .3-.9L7.2 4.3a1 1 0 0 0-1-.8z"/>',
}
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
