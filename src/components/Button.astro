---
import Icon from './Icon.astro'

interface Props {
  href: string
  variant?: 'primary' | 'secondary' | 'sea' | 'outline-light'
  size?: 'sm' | 'md' | 'lg'
  arrow?: boolean
  class?: string
  [key: string]: unknown
}
const { href, variant = 'primary', size = 'md', arrow = false, class: className, ...rest } = Astro.props
---

<a href={href} class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...rest}>
  <span><slot /></span>
  {arrow && <Icon name="arrow-right" size={17} class="btn__icon" />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.2s var(--ease-out-soft);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn--sm {
    padding: 0.62rem 1.05rem;
    font-size: 0.92rem;
  }

  .btn--md {
    padding: 0.85rem 1.4rem;
    font-size: 1rem;
  }

  .btn--lg {
    padding: 1.05rem 1.7rem;
    font-size: 1.05rem;
  }

  .btn--primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn--primary:hover {
    background: #26343d;
  }

  .btn--secondary {
    border-color: var(--color-rule);
    color: var(--color-ink);
  }

  .btn--secondary:hover {
    border-color: var(--color-ink);
  }

  .btn--sea {
    background: var(--color-sea);
    color: var(--color-ink);
  }

  .btn--sea:hover {
    background: var(--color-mint);
  }

  .btn--outline-light {
    border-color: var(--color-rule-dark);
    color: var(--color-paper);
  }

  .btn--outline-light:hover {
    border-color: var(--color-paper);
  }

  .btn__icon {
    transition: transform 0.25s var(--ease-out-soft);
  }

  .btn:hover .btn__icon {
    transform: translateX(3px);
  }

  /* Very small phones: let long labels wrap instead of overflowing */
  @media (max-width: 399px) {
    .btn {
      white-space: normal;
      text-align: center;
    }
  }
</style>
