---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHeader from '../components/PageHeader.astro'
import Button from '../components/Button.astro'
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <PageHeader
    eyebrow="404"
    title="This window seems to be closed."
    lede="The page you were looking for doesn’t exist or has moved."
  >
    <div class="actions">
      <Button href="/" arrow>Back to the homepage</Button>
      <Button href="/contact/" variant="secondary">Get a quote</Button>
    </div>
  </PageHeader>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
