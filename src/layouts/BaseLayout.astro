---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { site } from '../data/site'

interface Props {
  title: string
  description: string
  /** Full <title> override (used on the homepage) */
  fullTitle?: string
  noindex?: boolean
  ogType?: 'website' | 'article'
}

const { title, description, fullTitle, noindex = false, ogType = 'website' } = Astro.props
const pageTitle = fullTitle ?? `${title} | ${site.name}`
const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const ogImage = new URL('/og-image.png', Astro.site).toString()

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: new URL('/', Astro.site).toString(),
  description: site.description,
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  priceRange: '£299–£499',
  image: ogImage,
  ...(site.email ? { email: site.email } : {}),
  ...(site.socials.length ? { sameAs: site.socials.map((s) => s.href) } : {}),
}
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f5f5f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="new window. Web design and development" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      document.documentElement.classList.add('js')
      // If the site script fails to load, show everything rather than leaving content hidden
      setTimeout(function () {
        if (!window.__nwReady) document.documentElement.classList.remove('js')
      }, 3000)
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/site'
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-weight: 600;
    text-decoration: none;
    translate: 0 -200%;
  }

  .skip-link:focus {
    translate: 0 0;
  }

  main:focus {
    outline: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
