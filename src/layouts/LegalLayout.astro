---
import BaseLayout from './BaseLayout.astro'
import PageHeader from '../components/PageHeader.astro'

interface Props {
  title: string
  description: string
  updated: string
}
const { title, description, updated } = Astro.props
---

<BaseLayout title={title} description={description}>
  <PageHeader eyebrow={`Last updated ${updated}`} title={title} />
  <div class="shell legal">
    <div class="prose-nw">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4.5rem, 9vw, 7rem);
  }

  .legal :global(p),
  .legal :global(li) {
    color: #2c3740;
  }
</style>
